# Copy this file to .kaggle-dev.env and edit it, or let the Kaggle notebook generate it.
# .kaggle-dev.env is gitignored. Never put secrets here for a public repository.

INSTALL_SQLITE=1
INSTALL_POSTGRES=1
INSTALL_REDIS=1
INSTALL_ELASTIC=1
INSTALL_QDRANT=1
INSTALL_MISE_TOOLS=1

# PostgreSQL: multiple major versions are space-separated.
POSTGRES_VERSIONS="18"
POSTGRES_DEFAULT_VERSION="18"
POSTGRES_PORT_18=5433
POSTGRES_INSTALL_PGVECTOR=1
POSTGRES_AUTO_ENABLE_PGVECTOR=1
POSTGRES_AUTO_START_VERSIONS="18"

# Redis: exact upstream release versions, built from official source tarballs.
REDIS_VERSIONS="8.10.0"
REDIS_DEFAULT_VERSION="8.10.0"
REDIS_PORT_8_10_0=6379
REDIS_AUTO_START_VERSIONS="8.10.0"
REDIS_BUILD_JOBS=2

# Elastic Stack: exact versions. All selected components of one instance use the same version.
ELASTIC_VERSIONS="9.5.0"
ELASTIC_DEFAULT_VERSION="9.5.0"
ELASTIC_COMPONENTS="elasticsearch kibana logstash"
ELASTIC_PORT_9_5_0_ELASTICSEARCH=9200
ELASTIC_PORT_9_5_0_KIBANA=5601
ELASTIC_PORT_9_5_0_LOGSTASH_API=9600
ELASTIC_PORT_9_5_0_LOGSTASH_INPUT=5044
ELASTIC_HEAP_SIZE=512m
# Intentionally empty: Elastic is heavy; start explicitly with bin/kdev when needed.
ELASTIC_AUTO_START_VERSIONS=""

# Qdrant: exact upstream Qdrant versions managed through pinned Qdrant Native Portable.
QDRANT_VERSIONS="1.18.3"
QDRANT_DEFAULT_VERSION="1.18.3"
QDRANT_PORT_1_18_3=6333
QDRANT_GRPC_PORT_1_18_3=6334
QDRANT_ENABLE_GRPC=0
QDRANT_AUTO_START_VERSIONS="1.18.3"
QDRANT_PROFILE=auto
QNP_RELEASE=1.0.0
QNP_SOURCE_COMMIT=464cb5dbc1117a8a8a6472d76a10c5e329021156

# mise-managed language tools
MISE_VERSION=2026.8.1
TOOL_NODE_VERSION=26.6.0
TOOL_RUBY_VERSION=3.4.9
TOOL_NPM_VERSION=12.0.2
TOOL_YARN_VERSION=1.22.22
MISE_ADD_BASHRC_HOOK=1
